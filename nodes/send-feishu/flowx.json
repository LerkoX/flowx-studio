{
  "name": "send-feishu",
  "displayName": "发送飞书通知",
  "description": "通用飞书通知节点：通过飞书开放平台应用凭证向指定群聊发送卡片消息（内容支持 lark_md Markdown 格式），与具体业务内容无关",
  "version": "1.2.0",
  "author": "flowx-team",
  "tags": [
    "feishu",
    "notification"
  ],
  "icon": "💬",
  "language": "python",
  "entry": "main.py",
  "image": "python:3.11-slim",
  "executor": {
    "type": "local",
    "config": {
      "shell": "bash",
      "workdir": "/data/data/com.termux/files/home/.flowx-studio/workspace"
    }
  },
  "requirements": [
    "requests"
  ],
  "parameters": [
    {
      "name": "feishuAppId",
      "type": "string",
      "description": "飞书应用 App ID（开放平台自建应用的凭证）",
      "required": true
    },
    {
      "name": "feishuAppSecret",
      "type": "string",
      "description": "飞书应用 App Secret",
      "required": true
    },
    {
      "name": "feishuChatId",
      "type": "string",
      "description": "飞书群聊 Chat ID（oc_ 开头）",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "description": "卡片标题（纯文本），不传时默认为「通知」",
      "required": false,
      "default": "通知"
    },
    {
      "name": "content",
      "type": "string",
      "description": "要发送的消息正文（Markdown 文本，使用飞书 lark_md 语法渲染，支持 **加粗**、换行、列表等）",
      "required": true,
      "source": {
        "nodeRef": "get-weather",
        "output": "text",
        "description": "上游节点组织好的文本输出，如天气报告"
      }
    }
  ],
  "env": {
    "FEISHU_APP_ID": "{{ Param.feishuAppId }}",
    "FEISHU_APP_SECRET": "{{ Param.feishuAppSecret }}",
    "FEISHU_CHAT_ID": "{{ Param.feishuChatId }}",
    "FEISHU_TITLE": "{{ Param.title }}",
    "FEISHU_CONTENT": "{{ Param.content }}"
  },
  "run": "python3 main.py",
  "outputs": [
    {
      "name": "status",
      "type": "string",
      "description": "发送状态"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 320,
    "height": 340,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 60
}