{
  "name": "send-feishu",
  "displayName": "发送飞书通知",
  "description": "通过飞书 API 发送天气通知卡片消息（Markdown 格式）",
  "version": "1.1.0",
  "author": "flowx-team",
  "tags": ["feishu", "notification"],
  "icon": "💬",
  "language": "python",
  "entry": "main.py",
  "image": "python:3.11-slim",
  "executor": {
    "type": "local",
    "config": {
      "shell": "bash",
      "workdir": "/data/data/com.termux/files/home/.flowx-studio/workspace"
    }
  },
  "requirements": ["requests"],
  "parameters": [
    {
      "name": "feishuAppId",
      "type": "string",
      "description": "飞书应用 App ID（开放平台自建应用的凭证）",
      "required": true
    },
    {
      "name": "feishuAppSecret",
      "type": "string",
      "description": "飞书应用 App Secret",
      "required": true
    },
    {
      "name": "feishuChatId",
      "type": "string",
      "description": "飞书群聊 Chat ID（oc_ 开头）",
      "required": true
    },
    {
      "name": "weatherCity",
      "type": "string",
      "description": "天气报告对应的城市名（中文），如 深圳",
      "required": true,
      "source": { "nodeRef": "get-weather", "output": "city", "description": "天气查询节点的城市名输出" }
    },
    {
      "name": "weatherTemp",
      "type": "string",
      "description": "当前温度，纯数字字符串，单位 °C",
      "required": true,
      "source": { "nodeRef": "get-weather", "output": "temp" }
    },
    {
      "name": "weatherFeelsLike",
      "type": "string",
      "description": "体感温度，纯数字字符串，单位 °C",
      "required": false,
      "source": { "nodeRef": "get-weather", "output": "feelsLike" }
    },
    {
      "name": "weatherWeather",
      "type": "string",
      "description": "天气描述文字，如 晴朗 / 多云 / 中雨",
      "required": false,
      "source": { "nodeRef": "get-weather", "output": "weather" }
    },
    {
      "name": "weatherHumidity",
      "type": "string",
      "description": "相对湿度，纯数字字符串，单位 %",
      "required": false,
      "source": { "nodeRef": "get-weather", "output": "humidity" }
    },
    {
      "name": "weatherWindspeed",
      "type": "string",
      "description": "风速，纯数字字符串，单位 km/h",
      "required": false,
      "source": { "nodeRef": "get-weather", "output": "windspeed" }
    },
    {
      "name": "weatherUpdateTime",
      "type": "string",
      "description": "天气数据更新时间，如 2026-07-19 18:00",
      "required": false,
      "source": { "nodeRef": "get-weather", "output": "updateTime" }
    },
    {
      "name": "weatherForecasts",
      "type": "array",
      "description": "未来 N 天预报数组，元素含 date/weekday/minTemp/maxTemp/weather/chanceofrain 字段",
      "required": false,
      "source": { "nodeRef": "get-weather", "output": "forecasts", "description": "未来7天预报数组" }
    }
  ],
  "env": {
    "FEISHU_APP_ID": "{{ Param.feishuAppId }}",
    "FEISHU_APP_SECRET": "{{ Param.feishuAppSecret }}",
    "FEISHU_CHAT_ID": "{{ Param.feishuChatId }}",
    "WEATHER_CITY": "{{ Param.weatherCity }}",
    "WEATHER_TEMP": "{{ Param.weatherTemp }}",
    "WEATHER_FEELS_LIKE": "{{ Param.weatherFeelsLike }}",
    "WEATHER_WEATHER": "{{ Param.weatherWeather }}",
    "WEATHER_HUMIDITY": "{{ Param.weatherHumidity }}",
    "WEATHER_WINDSPEED": "{{ Param.weatherWindspeed }}",
    "WEATHER_UPDATE_TIME": "{{ Param.weatherUpdateTime }}",
    "WEATHER_FORECASTS": "{{ Param.weatherForecasts | toYaml }}"
  },
  "run": "python3 main.py",
  "outputs": [
    { "name": "status", "type": "string", "description": "发送状态" }
  ],
  "extract": {
    "type": "codec-block"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 260,
    "height": 150,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 60
}
