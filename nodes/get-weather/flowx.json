{
  "name": "get-weather",
  "displayName": "获取天气",
  "description": "从 Open-Meteo 免费天气 API 获取城市当前天气和未来7天预报，输出组织好的 Markdown 天气报告文本",
  "version": "1.1.0",
  "author": "flowx-team",
  "tags": [
    "weather",
    "api"
  ],
  "icon": "🌤️",
  "language": "python",
  "entry": "main.py",
  "image": "python:3.11-slim",
  "executor": {
    "type": "local",
    "config": {
      "shell": "bash",
      "workdir": "/data/data/com.termux/files/home/.flowx-studio/workspace"
    }
  },
  "requirements": [
    "requests",
    "pyyaml"
  ],
  "parameters": [
    {
      "name": "city",
      "type": "string",
      "description": "城市名称，如 深圳 / 北京 / Shanghai",
      "required": false,
      "default": "深圳"
    }
  ],
  "env": {
    "WEATHER_CITY": "{{ Param.city }}"
  },
  "run": "python3 main.py",
  "outputs": [
    {
      "name": "text",
      "type": "string",
      "description": "组织好的天气报告文本（Markdown 格式），包含当前天气与未来7天预报，可直接作为消息内容发送"
    }
  ],
  "extract": {
    "type": "codec-block"
  },
  "ui": {
    "entry": "ui/node-widget.js",
    "width": 1080,
    "height": 280,
    "collapsed": false,
    "apiVersion": 1
  },
  "timeout": 60
}